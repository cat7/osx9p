#!/bin/sh
# Mount every virtio-9p share at /Volumes/<mount tag>.
PATH=/bin:/sbin:/usr/bin:/usr/sbin

tags() {
	ioreg -r -c org_cat7_virtio9p -k mount-tag |
	    sed -n 's/.*"mount-tag" = "\(.*\)"$/\1/p'
}

# the driver loads when IOKit matches the device
i=0
while [ $i -lt 30 ]; do
	t=$(tags)
	[ -n "$t" ] && break
	sleep 1
	i=$((i + 1))
done

tags | while read -r tag; do
	[ -n "$tag" ] || continue
	mount -t 9p | grep -q "^$tag on " && continue
	dir="/Volumes/$tag"
	n=1
	while [ -e "$dir" ] && [ -n "$(ls -A "$dir" 2>/dev/null)" ]; do
		dir="/Volumes/$tag $n"
		n=$((n + 1))
	done
	mkdir -p "$dir"
	if ! mount_9p -o volume="$tag" "$tag" "$dir"; then
		rmdir "$dir"
		logger -t osx9p "cannot mount $tag"
	fi
done
exit 0
